{
  "name": "bloq",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "description": "BLOQ - Place. Clear. React. A Cnmbuck Studios block puzzle.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:release": "BLOQ_RELEASE=1 npm run build",
    "build:preview": "vite build --mode preview && node tools/single-file.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios:sync": "npm run build:release && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "simulate": "SIM=1 vitest run tools/simulate.spec.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
